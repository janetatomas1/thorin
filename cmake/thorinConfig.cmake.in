@PACKAGE_INIT@

# thorin's public dependencies; stb is private, but the static library still names it.
include(CMakeFindDependencyMacro)
find_dependency(sdl)
find_dependency(glbinding)
find_dependency(globjects)
find_dependency(concurrentqueue)
find_dependency(imgui)
find_dependency(implot)
find_dependency(implot3d)
find_dependency(function2)
find_dependency(yoga)
find_dependency(libassert)
find_dependency(stb)
find_dependency(spdlog)

include(${CMAKE_CURRENT_LIST_DIR}/thorinTargets.cmake)
check_required_components(thorin)
